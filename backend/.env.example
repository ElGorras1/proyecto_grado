# --- Base de datos ---
DATABASE_URL=postgresql+psycopg2://activos_user:activos_pass@localhost:5432/activos_db

# --- Seguridad JWT ---
JWT_SECRET_KEY=cambia-esta-clave-por-una-generada-con-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS (frontend Vite en local) ---
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# --- Entorno ---
ENVIRONMENT=development

# --- Inteligencia Artificial (Gemini) ---
GEMINI_API_KEY=tu_api_key_de_google_ai_studio_aqui

# --- Procedencia de las próximas cargas; no modifica tandas previas ---
KARDEX_TANDA_ACTUAL=3

# --- Alertas provisionales de movimientos (hora de Bolivia) ---
CONTROL_HORA_INICIO=7
CONTROL_HORA_FIN=20
CONTROL_CANTIDAD_EXTREMA=1000
CONTROL_PORCENTAJE_MAYORITARIO=80
CONTROL_STOCK_MINIMO_MAYORITARIO=10
CONTROL_FACTOR_ATIPICO=3
CONTROL_MIN_COMPARABLES=5
CONTROL_MIN_CANTIDAD_ATIPICA=10
CONTROL_REPETICION_MINUTOS=5
CONTROL_REGISTRO_TARDIO_HORAS=24
