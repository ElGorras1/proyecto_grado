{
  "name": "activos-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.vue",
    "format": "prettier --write \"src/**/*.{ts,vue}\""
  },
  "dependencies": {
    "vue": "^3.5.12",
    "vue-router": "^4.4.5",
    "pinia": "^2.2.4",
    "axios": "^1.7.7",
    "primevue": "^4.1.0",
    "primeicons": "^7.0.0",
    "@primevue/themes": "^4.1.0",
    "cytoscape": "^3.30.2"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vue-tsc": "^2.1.10",
    "vitest": "^2.1.3",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "@types/cytoscape": "^3.21.5",
    "eslint": "^9.13.0",
    "@eslint/js": "^9.13.0",
    "eslint-plugin-vue": "^9.29.0",
    "vue-eslint-parser": "^9.4.3",
    "globals": "^15.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "prettier": "^3.3.3"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "vue-demi@0.14.10": true
  }
}
